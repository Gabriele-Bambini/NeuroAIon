# Copy to .env and fill in. The engine reads these at startup.

# Required for live (non-mock) runs. Without it, the engine runs in --mock mode.
ANTHROPIC_API_KEY=

# Model used by every agent (Claude Opus 4.8 is the default and recommended).
NEUROAION_MODEL=claude-opus-4-8

# Optional: NCBI E-utilities credentials raise PubMed rate limits from 3 to 10 req/s.
# https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=
# A contact email is requested by NCBI / Crossref / OpenAlex "polite pool".
NEUROAION_CONTACT_EMAIL=02gabrielebambini@gmail.com

# Concurrency for the screening/extraction fan-out.
NEUROAION_MAX_WORKERS=8
